# Copy this file to .env and fill in real values.
# Never commit the actual .env file (it is excluded via .gitignore).

# --- LLM API (Phase 3A: src/llm_parser.py) ---
# Phase 3A only supports Anthropic. LLM_PROVIDER exists for forward
# compatibility but any value other than "anthropic" will raise a
# configuration error.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- App settings ---
APP_ENV=development
