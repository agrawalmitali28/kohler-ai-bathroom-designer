# Copy this file to .env and fill in real values.
# Never commit the actual .env file (it is excluded via .gitignore).

# --- LLM API (choose whichever provider you integrate in Phase 2) ---
LLM_PROVIDER=openai            # e.g. openai | anthropic
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini           # placeholder model name, update as needed

# --- App settings ---
APP_ENV=development
